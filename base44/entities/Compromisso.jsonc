{
  "name": "Compromisso",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do compromisso"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de in\u00edcio"
    },
    "data_fim": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de t\u00e9rmino"
    },
    "cor": {
      "type": "string",
      "default": "#0891b2",
      "description": "Cor do evento"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente relacionado"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "agendado",
        "delay",
        "reuniao_realizada",
        "venda_feita",
        "pessoal",
        "avanti"
      ],
      "default": "agendado",
      "description": "Tipo de compromisso"
    },
    "status_origem": {
      "type": "string",
      "description": "Status do lead quando agendado"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o do compromisso"
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "online",
        "presencial"
      ],
      "description": "Modalidade do compromisso"
    },
    "meeting_link": {
      "type": "string",
      "description": "Link da reuni\u00e3o online"
    },
    "email_participante": {
      "type": "string",
      "description": "Email do participante/convidado"
    },
    "email_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Se o email de convite foi enviado"
    },
    "convidado_confirmou": {
      "type": "boolean",
      "default": false,
      "description": "Se o convidado confirmou presen\u00e7a"
    },
    "convidado_recusou": {
      "type": "boolean",
      "default": false,
      "description": "Se o convidado recusou o convite"
    },
    "google_event_id": {
      "type": "string",
      "description": "ID do evento no Google Calendar"
    },
    "is_fixo": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 um compromisso fixo semanal"
    },
    "fixo_dias_semana": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Dias da semana do compromisso fixo"
    },
    "fixo_hora_inicio": {
      "type": "string",
      "description": "Hora de in\u00edcio do compromisso fixo (HH:mm)"
    },
    "fixo_hora_fim": {
      "type": "string",
      "description": "Hora de fim do compromisso fixo (HH:mm)"
    },
    "fixo_data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da recorr\u00eancia"
    },
    "fixo_data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de fim da recorr\u00eancia"
    },
    "lembrete_1h_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Se o lembrete de 1h foi enviado"
    },
    "lembrete_30min_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Se o lembrete de 30min foi enviado"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio do compromisso"
    }
  },
  "required": [
    "titulo",
    "data_inicio",
    "data_fim"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.email_participante": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.email_participante": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    }
  }
}