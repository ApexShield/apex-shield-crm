{
  "name": "Meta",
  "type": "object",
  "properties": {
    "periodo": {
      "type": "string",
      "description": "Per\u00edodo da meta no formato YYYY-MM (ex: 2025-04)"
    },
    "periodo_label": {
      "type": "string",
      "description": "Label leg\u00edvel do per\u00edodo (ex: Abril 2025)"
    },
    "ligacoes_realizadas": {
      "type": "number",
      "default": 0,
      "description": "Meta de liga\u00e7\u00f5es realizadas"
    },
    "agendamentos_feitos": {
      "type": "number",
      "default": 0,
      "description": "Meta de agendamentos feitos"
    },
    "abs_realizadas": {
      "type": "number",
      "default": 0,
      "description": "Meta de ABs realizadas"
    },
    "f_realizados": {
      "type": "number",
      "default": 0,
      "description": "Meta de F realizados"
    },
    "n_protocoladas": {
      "type": "number",
      "default": 0,
      "description": "Meta de propostas realizadas"
    },
    "recs": {
      "type": "number",
      "default": 0,
      "description": "Meta de RECS"
    },
    "pa": {
      "type": "number",
      "default": 0,
      "description": "Meta de PA"
    },
    "cs": {
      "type": "number",
      "default": 0,
      "description": "Meta de CS"
    }
  },
  "required": [
    "periodo"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}