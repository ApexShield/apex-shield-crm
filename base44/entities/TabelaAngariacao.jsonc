{
  "name": "TabelaAngariacao",
  "type": "object",
  "properties": {
    "faixa_pa_min": {
      "type": "number",
      "description": "PA m\u00ednimo da faixa (R$)"
    },
    "faixa_pa_max": {
      "type": "number",
      "description": "PA m\u00e1ximo da faixa (R$)"
    },
    "premio_angariacao": {
      "type": "number",
      "description": "Valor do pr\u00eamio de angaria\u00e7\u00e3o (R$)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da faixa"
    }
  },
  "required": [
    "faixa_pa_min",
    "faixa_pa_max",
    "premio_angariacao"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}