{
  "name": "TabelaComissao",
  "type": "object",
  "properties": {
    "produto": {
      "type": "string",
      "enum": [
        "VS5",
        "VS10",
        "VS15",
        "VS20",
        "VS25",
        "VS75",
        "VT5",
        "VT10",
        "VT20",
        "VT65",
        "VT99",
        "VT Legado 10",
        "VT Legado 2",
        "VT Singular",
        "VT Singular Legado"
      ],
      "description": "C\u00f3digo do produto"
    },
    "frequencia_pagamento": {
      "type": "string",
      "enum": [
        "Anual",
        "Mensal"
      ],
      "description": "Frequ\u00eancia de pagamento"
    },
    "periodo_pagamento": {
      "type": "string",
      "enum": [
        "At\u00e9 1 ano",
        "Ap\u00f3s 2 anos",
        "Ap\u00f3s 3 anos",
        "Ap\u00f3s 4 anos",
        "Vital\u00edcio"
      ],
      "description": "Per\u00edodo de pagamento da comiss\u00e3o"
    },
    "percentual_comissao": {
      "type": "number",
      "description": "Percentual de comiss\u00e3o (%)"
    }
  },
  "required": [
    "produto",
    "frequencia_pagamento",
    "periodo_pagamento",
    "percentual_comissao"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}