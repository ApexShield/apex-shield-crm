{
  "name": "Transacao",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "Despesa",
        "Receita"
      ],
      "description": "Tipo da transa\u00e7\u00e3o"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da transa\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "valor": {
      "type": "number",
      "description": "Valor da transa\u00e7\u00e3o"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da transa\u00e7\u00e3o"
    },
    "tipo_pagamento": {
      "type": "string",
      "enum": [
        "CARTAO CREDITO",
        "CARTAO DEBITO",
        "PIX",
        "DINHEIRO"
      ],
      "description": "Tipo de pagamento"
    },
    "parcelas": {
      "type": "number",
      "description": "Quantidade de parcelas (para cart\u00e3o de cr\u00e9dito)"
    },
    "numero_parcela": {
      "type": "number",
      "description": "N\u00famero da parcela atual"
    },
    "transacao_origem_id": {
      "type": "string",
      "description": "ID da transa\u00e7\u00e3o original (para parcelas)"
    }
  },
  "required": [
    "tipo",
    "categoria",
    "descricao",
    "valor",
    "data",
    "tipo_pagamento"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}