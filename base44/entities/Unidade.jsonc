{
  "name": "Unidade",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da unidade"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da unidade"
    },
    "agencia_id": {
      "type": "string",
      "description": "ID da ag\u00eancia vinculada"
    },
    "agencia_nome": {
      "type": "string",
      "description": "Nome da ag\u00eancia"
    },
    "lider_unidade_id": {
      "type": "string",
      "description": "ID do l\u00edder da unidade"
    },
    "lider_unidade_email": {
      "type": "string",
      "description": "Email do l\u00edder da unidade"
    },
    "lider_unidade_nome": {
      "type": "string",
      "description": "Nome do l\u00edder da unidade"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Status da unidade"
    }
  },
  "required": [
    "nome",
    "agencia_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.lider_unidade_email": "{{user.email}}"
        },
        {
          "data.agencia_id": "{{user.data.agencia_id}}",
          "user_condition": {
            "data.tipo_hierarquia": "L\u00edder de Ag\u00eancia"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.lider_unidade_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}