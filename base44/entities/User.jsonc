{
  "name": "User",
  "type": "object",
  "properties": {
    "aceite_termos": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o usu\u00e1rio aceitou os Termos de Servi\u00e7o e Pol\u00edtica de Privacidade"
    },
    "data_aceite_termos": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do aceite dos Termos de Servi\u00e7o e Pol\u00edtica de Privacidade"
    },
    "aceite_politica_privacidade": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o usu\u00e1rio aceitou a pol\u00edtica de privacidade"
    },
    "data_aceite_politica": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do aceite da pol\u00edtica de privacidade"
    },
    "alias_usuario": {
      "type": "string",
      "description": "Alias \u00fanico do usu\u00e1rio (3 caracteres)"
    },
    "tipo_hierarquia": {
      "type": "string",
      "enum": [
        "UsuarioVIP",
        "LiderUnidade",
        "LiderAgencia"
      ],
      "description": "Tipo de hierarquia do usu\u00e1rio"
    },
    "agencia_id": {
      "type": "string",
      "description": "ID da ag\u00eancia"
    },
    "agencia_nome": {
      "type": "string",
      "description": "Nome da ag\u00eancia"
    },
    "unidade_id": {
      "type": "string",
      "description": "ID da unidade"
    },
    "unidade_nome": {
      "type": "string",
      "description": "Nome da unidade"
    },
    "telefone_whatsapp": {
      "type": "string",
      "description": "N\u00famero de telefone WhatsApp vinculado \u00e0 conta"
    },
    "link_reuniao_padrao": {
      "type": "string",
      "description": "Link padr\u00e3o para reuni\u00f5es online"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "canceled"
      ],
      "default": "inactive",
      "description": "Status da assinatura Stripe"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "ID do cliente no Stripe"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "ID da assinatura no Stripe"
    },
    "subscription_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de in\u00edcio da assinatura"
    },
    "integration_usage_count": {
      "type": "number",
      "default": 0,
      "description": "Contador de uso de integra\u00e7\u00f5es (emails enviados, etc.)"
    },
    "integration_usage_reset_date": {
      "type": "string",
      "format": "date",
      "description": "Data do \u00faltimo reset do contador de integra\u00e7\u00f5es"
    },
    "is_vip": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio \u00e9 VIP (limite de 500 integra\u00e7\u00f5es ao inv\u00e9s de 100)"
    }
  },
  "required": [
    "alias_usuario",
    "tipo_hierarquia",
    "agencia_id",
    "agencia_nome",
    "unidade_id",
    "unidade_nome"
  ]
}