{
  "name": "Cliente Signed - Drive + Gmail",
  "description": "Quando o status do Cliente muda para Signed, chama a API externa para criar pasta no Drive e rascunho de email de boas-vindas",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Signed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Cliente"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cliente_signed_drive_gmail",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onClienteSigned",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onClienteSigned"
  }
}